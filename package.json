{
  "name": "kriegsschrei",
  "productName": "Kriegsschrei",
  "version": "2.0.0",
  "description": "Kriegsschrei Facecam-Filter",
  "author": "Kriegsschrei",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.kriegsschrei.facecam",
    "productName": "Kriegsschrei",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "node_modules/@mediapipe/tasks-vision/**/*"
    ],
    "asar": true,
    "directories": { "output": "dist" },
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "Kriegsschrei.exe" }
  }
}
